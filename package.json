{
  "name": "paperdesk",
  "version": "0.2.0",
  "description": "Local LaTeX editor with live PDF preview, SyncTeX, and an AI agent powered by the Codex or Claude Code CLI.",
  "keywords": [
    "latex",
    "tex",
    "latex-editor",
    "pdf",
    "synctex",
    "latexmk",
    "codex",
    "local-first",
    "overleaf-alternative",
    "claude-code",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Michael Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-L-i/paperdesk.git"
  },
  "homepage": "https://github.com/michael-L-i/paperdesk#readme",
  "bugs": "https://github.com/michael-L-i/paperdesk/issues",
  "type": "module",
  "bin": {
    "paperdesk": "bin/paperdesk.js"
  },
  "files": [
    "bin",
    "server",
    "dist",
    ".agents"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/paperdesk.js",
    "dev": "node server/index.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:sync": "node tests/sync-browser.mjs",
    "test:ai": "node tests/ai-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@playwright/test": "^1.51.0",
    "@uiw/react-codemirror": "^4.23.0",
    "@vitejs/plugin-react": "^4.3.4",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.1.0"
  }
}
